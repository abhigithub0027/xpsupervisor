<?xml version="1.0" encoding="utf-8"?>
<!-- One recording on the device. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_8sdp"
    android:background="@drawable/bg_session_card"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:id="@+id/vStateDot"
            android:layout_width="@dimen/_8sdp"
            android:layout_height="@dimen/_8sdp"
            android:layout_marginEnd="@dimen/_8sdp"
            android:background="@drawable/bg_circle_yellow" />

        <TextView
            android:id="@+id/tvName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="middle"
            android:fontFamily="@font/circular_std_bold"
            android:maxLines="1"
            android:textColor="?attr/primaryTextColor"
            android:textSize="@dimen/_11ssp"
            tools:text="device_D7A3_…_191615" />

        <TextView
            android:id="@+id/tvState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:fontFamily="@font/nunito_medium"
            android:textSize="@dimen/_8ssp"
            tools:text="Pending" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nunito_medium"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="@dimen/_9ssp"
        tools:text="1.7 GB · 5:00 · 21 Aug, 19:16" />

    <TextView
        android:id="@+id/tvTask"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:ellipsize="middle"
        android:fontFamily="@font/nunito_medium"
        android:maxLines="1"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="@dimen/_8ssp"
        tools:text="Task task-42 · segment 3"
        tools:visibility="visible" />
</LinearLayout>
