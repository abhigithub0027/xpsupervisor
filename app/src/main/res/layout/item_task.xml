<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_session_card"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_unselected"
            android:fontFamily="@font/nunito_medium"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_3sdp"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="@dimen/_9ssp"
            tools:text="Household" />

        <TextView
            android:id="@+id/tvTaskCode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:layout_weight="1"
            android:fontFamily="@font/nunito_medium"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="@dimen/_9ssp"
            tools:text="HHKC2-002" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_8sdp"
        android:fontFamily="@font/circular_std_bold"
        android:textColor="?attr/primaryTextColor"
        android:textSize="@dimen/_12ssp"
        tools:text="Cleaning kitchen slab / counter" />

    <TextView
        android:id="@+id/tvTaskMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_4sdp"
        android:fontFamily="@font/nunito_medium"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="@dimen/_9ssp"
        tools:text="Min duration: 10 min · Priority: Medium" />
</LinearLayout>
