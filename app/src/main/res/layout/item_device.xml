<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/_10sdp"
    android:background="@drawable/bg_session_card"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvDeviceName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/circular_std_bold"
            android:textColor="?attr/primaryTextColor"
            android:textSize="@dimen/_12ssp"
            tools:text="CC843" />

        <TextView
            android:id="@+id/tvLinkState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tab_unselected"
            android:fontFamily="@font/circular_std_bold"
            android:paddingHorizontal="@dimen/_10sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:textSize="@dimen/_9ssp"
            tools:text="In range" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAssignee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_6sdp"
        android:fontFamily="@font/nunito_medium"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="@dimen/_9ssp"
        tools:text="Assigned to Abhay Jadon" />

    <TextView
        android:id="@+id/tvDeviceMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_2sdp"
        android:fontFamily="@font/nunito_medium"
        android:textColor="?attr/secondaryTextColor"
        android:textSize="@dimen/_9ssp"
        tools:text="kit-ego-luckfox-v3 · 189 sessions" />
</LinearLayout>
