<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="android.view.View" />
        <variable name="session" type="com.miniaturesoftwares.xpjobssuperviser.ui.models.UploadedSession" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_6sdp" android:layout_marginEnd="@dimen/_6sdp"
        android:layout_marginBottom="@dimen/_12sdp"
        android:background="@drawable/bg_session_card"
        android:padding="@dimen/_12sdp">

        <FrameLayout
            android:id="@+id/thumbContainer"
            android:layout_width="@dimen/_75sdp"
            android:layout_height="@dimen/_75sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="?attr/dividerColor">

                <ImageView
                    android:id="@+id/ivThumbnail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    app:imageResource="@{session.thumbnailResId}" />

                <androidx.media3.ui.PlayerView
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone"
                    app:use_controller="false"
                    app:resize_mode="zoom" />

                <ImageView
                    android:id="@+id/ivPlay"
                    android:layout_width="@dimen/_24sdp"
                    android:layout_height="@dimen/_24sdp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_play"
                    android:visibility="gone"
                    app:tint="#FFFFFF" />
            </androidx.cardview.widget.CardView>
        </FrameLayout>

        <TextView
            android:id="@+id/tvSessionName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:text="@{session.title}"
            android:textColor="?attr/primaryTextColor"
            android:textSize="@dimen/_12ssp"
            android:fontFamily="@font/circular_std_bold"
            android:singleLine="true"
            android:ellipsize="middle"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/rowDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_6sdp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintTop_toBottomOf="@id/tvSessionName">

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:src="@drawable/ic_calendar"
                app:tint="?attr/secondaryTextColor"/>
            <TextView
                android:id="@+id/tvDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@{session.date}"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="@dimen/_9ssp" />

            <ImageView
                android:layout_width="@dimen/_10sdp"
                android:layout_height="@dimen/_10sdp"
                android:layout_marginStart="@dimen/_8sdp"
                android:src="@drawable/ic_clock"
                app:tint="?attr/secondaryTextColor" />
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_4sdp"
                android:text="@{session.time}"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_4sdp"
            android:text="@{session.size + ` • ` + session.fileCount + ` file(s)`}"
            android:textColor="?attr/secondaryTextColor"
            android:textSize="@dimen/_9ssp"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintTop_toBottomOf="@id/rowDate" />

        <TextView
            android:id="@+id/btnAction"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:layout_marginStart="@dimen/_12sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@{session.isFailed ? @drawable/bg_btn_failed : @drawable/bg_btn_uploaded}"
            android:gravity="center"
            android:paddingStart="@dimen/_16sdp" android:paddingEnd="@dimen/_16sdp"
            android:text="@{session.isFailed ? @string/failed : (session.qcStatus != null &amp;&amp; session.qcStatus.equalsIgnoreCase(`Queued`) ? `Done` : @string/uploaded)}"
            android:textColor="@color/white"
            android:textSize="@dimen/_10ssp"
            android:fontFamily="@font/nunito_bold"
            app:layout_constraintStart_toEndOf="@id/thumbContainer"
            app:layout_constraintTop_toBottomOf="@id/tvSize" />

        <TextView
            android:id="@+id/tvAnnotationStatus"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/_24sdp"
            android:layout_marginStart="@dimen/_8sdp"
            android:background="@drawable/bg_btn_uploaded"
            android:gravity="center"
            android:paddingStart="@dimen/_12sdp" android:paddingEnd="@dimen/_12sdp"
            android:text='@{session.annotationStatus != null ? session.annotationStatus : ""}'
            android:textColor="@color/white"
            android:textSize="@dimen/_9ssp"
            android:fontFamily="@font/nunito_bold"
            android:visibility="@{!session.isFailed &amp;&amp; session.annotationStatus != null &amp;&amp; !session.annotationStatus.empty &amp;&amp; (session.qcStatus == null || !session.annotationStatus.equalsIgnoreCase(session.qcStatus)) &amp;&amp; !session.annotationStatus.equalsIgnoreCase(`Queued`) ? View.VISIBLE : View.GONE}"
            app:layout_constraintStart_toEndOf="@id/btnAction"
            app:layout_constraintTop_toTopOf="@id/btnAction"
            app:layout_constraintBottom_toBottomOf="@id/btnAction" />

        <TextView
            android:id="@+id/tvRejectionReason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/bg_tag_outline"
            android:fontFamily="@font/nunito_medium"
            android:paddingHorizontal="@dimen/_8sdp"
            android:paddingVertical="@dimen/_4sdp"
            android:text="@{session.rejectionReason}"
            android:textColor="#F44336"
            android:textSize="@dimen/_9ssp"
            android:visibility="@{session.isFailed ? View.GONE : View.GONE}"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tvSessionName"
            app:layout_constraintTop_toBottomOf="@id/btnAction" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
