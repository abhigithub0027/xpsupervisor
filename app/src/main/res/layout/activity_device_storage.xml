<?xml version="1.0" encoding="utf-8"?>
<!-- Upload progress and on-device recordings for one cap.

     Layout order follows what a supervisor actually needs to decide: is the
     backlog draining (the summary card), then what is on the device and in
     what state (the list). The list is paged, because a cap that has been out
     of coverage can hold hundreds of segments and they arrive over BLE. -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_screen">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/headerLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/backgroundColor"
            android:paddingStart="@dimen/_16sdp"
            android:paddingTop="@dimen/_30sdp"
            android:paddingEnd="@dimen/_16sdp"
            android:paddingBottom="@dimen/_12sdp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/bg_tab_inactive"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_back_arrow"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/secondaryTextColor" />

            <TextView
                android:id="@+id/tvHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:ellipsize="end"
                android:fontFamily="@font/circular_std_bold"
                android:maxLines="1"
                android:text="@string/device_storage"
                android:textColor="?attr/primaryTextColor"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintEnd_toStartOf="@id/btnRefresh"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toTopOf="@id/btnBack" />

            <TextView
                android:id="@+id/tvHeaderSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:ellipsize="end"
                android:fontFamily="@font/nunito_medium"
                android:maxLines="1"
                android:textColor="?attr/secondaryTextColor"
                android:textSize="@dimen/_9ssp"
                app:layout_constraintEnd_toStartOf="@id/btnRefresh"
                app:layout_constraintStart_toEndOf="@id/btnBack"
                app:layout_constraintTop_toBottomOf="@id/tvHeaderTitle"
                tools:text="Cap 07 · connected" />

            <ImageView
                android:id="@+id/btnRefresh"
                android:layout_width="@dimen/_32sdp"
                android:layout_height="@dimen/_32sdp"
                android:background="@drawable/bg_tab_inactive"
                android:contentDescription="@string/refresh"
                android:padding="@dimen/_8sdp"
                android:src="@drawable/ic_refresh"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/secondaryTextColor" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="@dimen/_16sdp"
                    android:paddingTop="@dimen/_12sdp"
                    android:paddingEnd="@dimen/_16sdp"
                    android:paddingBottom="@dimen/_24sdp">

                    <include
                        android:id="@+id/cardUpload"
                        layout="@layout/view_upload_summary" />

                    <!-- Shown instead of numbers when the device has published
                         no uploader status at all. Silence here is ambiguous -
                         it could mean "nothing to upload" or "the uploader has
                         never run" - so it is called out rather than rendered
                         as a healthy set of zeroes. -->
                    <TextView
                        android:id="@+id/tvUploaderUnknown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_session_card"
                        android:fontFamily="@font/nunito_medium"
                        android:padding="@dimen/_12sdp"
                        android:text="@string/uploader_status_unknown"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="@dimen/_10ssp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_16sdp"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:fontFamily="@font/circular_std_bold"
                        android:text="@string/recordings_on_device"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/_12ssp" />

                    <TextView
                        android:id="@+id/tvRecordingsSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/_8sdp"
                        android:fontFamily="@font/nunito_medium"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="@dimen/_9ssp"
                        tools:text="12 files · 4.2 GB on device · 109 GB free" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvRecordings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_device_recording" />

                    <TextView
                        android:id="@+id/btnLoadMore"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@drawable/bg_btn_outline"
                        android:fontFamily="@font/circular_std_bold"
                        android:gravity="center"
                        android:padding="@dimen/_10sdp"
                        android:text="@string/load_more"
                        android:textColor="?attr/primaryTextColor"
                        android:textSize="@dimen/_10ssp"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <TextView
                        android:id="@+id/tvEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_32sdp"
                        android:fontFamily="@font/nunito_medium"
                        android:gravity="center"
                        android:text="@string/no_recordings_on_device"
                        android:textColor="?attr/secondaryTextColor"
                        android:textSize="@dimen/_10ssp"
                        android:visibility="gone" />
                </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/headerLayout" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
